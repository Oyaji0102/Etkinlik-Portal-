@model IEnumerable<dens11.ViewModels.VenueViewModel>

<h1>Mekan Yönetimi</h1>

<p>
    <a asp-action="CreateVenue" class="btn btn-primary">Yeni Mekan Ekle</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Ad</th>
            <th>Adres</th>
            <th>İşlemler</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Address</td>
                <td>
                    <a asp-action="EditVenue" asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">Düzenle</a>
                    <a asp-action="DeleteVenue" asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">Sil</a>
                </td>
            </tr>
        }
    </tbody>
</table>
